{
    "name": "opencompanyapp/astronomy-bundle",
    "description": "PHP library for astronomical calculations — moon phases, sunrise/sunset, planet positions, solar and lunar eclipses, coordinate transformations. Maintained by OpenCompany for AI agent capabilities. Based on Jean Meeus' Astronomical Algorithms and VSOP87 theory.",
    "license": "MIT",
    "authors": [
        {
            "name": "Andreas Moeller",
            "email": "andrmoel@gmail.com"
        },
        {
            "name": "OpenCompany",
            "homepage": "https://github.com/OpenCompanyApp"
        }
    ],
    "keywords": ["astronomy", "celestial", "moon", "sun", "planets", "eclipse", "coordinates", "opencompany"],
    "require": {
        "php": "^7.2 || ^8.0",
        "ext-json": "*"
    },
    "autoload": {
        "psr-4": {
            "OpenCompany\\AstronomyBundle\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "OpenCompany\\AstronomyBundle\\Tests\\": "tests/"
        }
    },
    "require-dev": {
        "symfony/phpunit-bridge": "^4.1",
        "phpunit/phpunit": "^8"
    }
}
